            <property name="minimumHeight">
             <number>32</number>
            </property>
            <property name="styleSheet">
             <string notr="true">font-weight: bold; background-color: #1565C0; color: white; padding: 5px 14px;</string>
            </property>
            <property name="text">
             <string>Iniciar Respaldo a Carpeta</string>
            </property>
           </widget>
          </item>
         </layout>
        </item>
       </layout>
      </widget>
      <!-- PESTAÑA 2: EXPORTAR A ZIP -->
      <widget class="QWidget" name="tab_exportar_zip">
