        </item>
        <item row="2" column="0" colspan="3">
         <widget class="QCheckBox" name="chk_forzar_reemplazo_zip">
          <property name="text">
           <string>Forzar reemplazo de todos los archivos existentes (si se desmarca, solo reemplaza si el del ZIP es más reciente o no existe)</string>
          </property>
          <property name="checked">
           <bool>false</bool>
          </property>
         </widget>
        </item>
        <item row="3" column="0" colspan="3">
