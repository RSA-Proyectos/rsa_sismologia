              <width>20</width>
              <height>20</height>
             </size>
            </property>
           </spacer>
          </item>
         </layout>
        </item>
        <item row="3" column="0" colspan="3">
         <widget class="QGroupBox" name="grp_modo_carpeta">
          <property name="title">
           <string>Alcance del respaldo</string>
          </property>
          <layout class="QVBoxLayout" name="lay_modo_carpeta">
           <item>
            <widget class="QRadioButton" name="rb_carpeta_liviano">
             <property name="text">
              <string>Respaldo liviano — Omitir archivos pesados (mseed\registros continuos y archivos .pdf)</string>
             </property>
             <property name="checked">
              <bool>true</bool>
             </property>
             <property name="toolTip">
              <string>Conserva toda la base operativa (CSV, _aux, _cat, _rep, _res, XML, dia/.sis/.fas, fastHypo/, mseed/eventos/, reportes, procesamiento, shapes) omitiendo registros continuos de 24h y PDFs.</string>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QRadioButton" name="rb_carpeta_completo">
             <property name="text">
              <string>Respaldo completo — Copiar absolutamente todo el contenido del directorio origen</string>
             </property>
            </widget>
           </item>
          </layout>
         </widget>
        </item>
        <item row="4" column="0" colspan="3">
