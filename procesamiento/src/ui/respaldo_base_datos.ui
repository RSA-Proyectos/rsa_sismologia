      </property>
      <property name="wordWrap">
       <bool>true</bool>
      </property>
      <property name="text">
       <string>Respalda incrementalmente el directorio de trabajo (ej. Google Drive G:\Mi unidad\DIA\) hacia una carpeta maestra o archivo ZIP portable. Nunca borra archivos en el destino: solo copia archivos nuevos o más recientes.</string>
      </property>
     </widget>
    </item>
    <item>
     <widget class="QTabWidget" name="tabs_respaldo">
      <property name="currentIndex">
       <number>0</number>
      </property>
      <!-- PESTAÑA 1: SINCRONIZAR A CARPETA -->
      <widget class="QWidget" name="tab_carpeta">
       <attribute name="title">
        <string>1. Sincronizar a Carpeta</string>
       </attribute>
       <layout class="QGridLayout" name="grid_tab_carpeta">
        <item row="0" column="0">
         <widget class="QLabel" name="lbl_orig_c">
          <property name="text">
           <string>Carpeta Origen (trabajo):</string>
          </property>
         </widget>
        </item>
        <item row="0" column="1">
         <widget class="QLineEdit" name="txt_origen_carpeta">
          <property name="placeholderText">
           <string>Ej. G:\Mi unidad\DIA\  o una subcarpeta de año/mes/día</string>
          </property>
         </widget>
        </item>
        <item row="0" column="2">
         <widget class="QPushButton" name="btn_examinar_origen_carpeta">
          <property name="text">
           <string>Examinar...</string>
          </property>
         </widget>
        </item>
        <item row="1" column="0">
         <widget class="QLabel" name="lbl_dest_c">
          <property name="text">
           <string>Carpeta Destino (respaldo):</string>
          </property>
         </widget>
        </item>
        <item row="1" column="1">
         <widget class="QLineEdit" name="txt_destino_carpeta">
          <property name="placeholderText">
           <string>Ej. C:\DIA\  o disco externo de respaldo maestro</string>
          </property>
         </widget>
        </item>
        <item row="1" column="2">
         <widget class="QPushButton" name="btn_examinar_destino_carpeta">
          <property name="text">
           <string>Examinar...</string>
          </property>
         </widget>
        </item>
        <item row="2" column="0" colspan="3">
         <layout class="QHBoxLayout" name="lay_periodo_carpeta">
          <item>
           <widget class="QCheckBox" name="chk_periodo_carpeta">
            <property name="text">
             <string>Filtrar por período:</string>
            </property>
            <property name="checked">
