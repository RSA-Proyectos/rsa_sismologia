   </rect>
  </property>
  <property name="windowTitle">
   <string>RECONSTRUCCIÓN DE EVENTOS POR PERÍODO - RSA</string>
  </property>
  <widget class="QWidget" name="widget_central">
   <layout class="QVBoxLayout" name="layout_principal">
    <property name="spacing">
     <number>10</number>
    </property>
    <property name="leftMargin">
